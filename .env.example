# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Required. The one real AI call (triage of a tenant's message) goes through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional. Leave empty and the app picks the newest Claude Opus that OpenRouter lists.
# Set a model id from https://openrouter.ai/models to use a different one.
OPENROUTER_MODEL=

# Optional. PostHog project key (starts with phc_) for the local app: pageviews, clicks, session replay.
# This key is public by design (it can only send events), so it is filled in here. Empty turns analytics off.
POSTHOG_KEY=phc_nhLfda5VvpsosBJEKraGbNVpVVNNBifV4fVQ4R5NkR2g
# Use https://eu.i.posthog.com if your PostHog project is in the EU.
POSTHOG_HOST=https://us.i.posthog.com

# Optional. The app runs at http://localhost:3000 unless you change this.
PORT=3000

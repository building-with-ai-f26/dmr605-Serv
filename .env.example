# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Which AI makes the one real call (triage of a tenant's message).
#   claude-code  (default) Claude Code on this computer, using the Claude subscription you are signed in to.
#                No API key and no per-call bill. Install Claude Code and run `claude` once to sign in.
#   openrouter   Pay-per-call through OpenRouter. Needs OPENROUTER_API_KEY below and paid credits.
AI_PROVIDER=claude-code

# Optional, claude-code only. Empty uses your subscription's default model. Example: sonnet
CLAUDE_MODEL=

# openrouter only.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
# Empty picks the newest Claude Opus that OpenRouter lists. Or set a model id from https://openrouter.ai/models
OPENROUTER_MODEL=

# Optional. PostHog project key (starts with phc_) for the local app: pageviews, clicks, session replay.
# This key is public by design (it can only send events), so it is filled in here. Empty turns analytics off.
POSTHOG_KEY=phc_nhLfda5VvpsosBJEKraGbNVpVVNNBifV4fVQ4R5NkR2g
# Use https://eu.i.posthog.com if your PostHog project is in the EU.
POSTHOG_HOST=https://us.i.posthog.com

# Optional. The app runs at http://localhost:3000 unless you change this.
PORT=3000
